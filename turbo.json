{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", "tsconfig.base.json"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "ADMIN_JWT_SECRET",
    "ADMIN_JWT_TTL_SECONDS",
    "ADMIN_SEED_EMAIL",
    "ADMIN_SEED_PASSWORD",
    "API_PORT",
    "API_RATE_LIMIT",
    "API_RATE_TTL_MS",
    "AUTH_RATE_LIMIT",
    "AUTH_RATE_TTL_MS",
    "PARENT_JWT_SECRET",
    "PARENT_SESSION_TTL_SECONDS",
    "PARENT_AUTH_RATE_LIMIT",
    "PARENT_AUTH_RATE_TTL_MS",
    "COOKIE_SECURE",
    "MAIL_TRANSPORT",
    "MAIL_FROM",
    "MAIL_API_URL",
    "MAIL_API_KEY",
    "MAIL_TIMEOUT_MS",
    "MAIL_LOG_FILE",
    "WEB_ORIGIN",
    "NEXT_PUBLIC_API_URL"
  ],
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build", "db:generate"]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"]
    },
    "test": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false
    },
    "//#e2e": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
