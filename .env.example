
# --- Runtime ---
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# --- Database (compose.yml maps postgres to host port 5433) ---
DATABASE_URL=postgresql://nts:nts@localhost:5433/nts?schema=public

# --- Admin ---
# Must be at least 32 characters and must not be left as this placeholder.
ADMIN_JWT_SECRET=change-me-in-every-environment
ADMIN_JWT_TTL_SECONDS=28800
ADMIN_SEED_EMAIL=operator@example.test
ADMIN_SEED_PASSWORD=change-me-too

# --- Rate limiting (defaults shown; optional) ---
API_RATE_LIMIT=300
API_RATE_TTL_MS=60000
AUTH_RATE_LIMIT=5
AUTH_RATE_TTL_MS=60000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# --- Parent sessions (Epic 1) ---
# Must differ from ADMIN_JWT_SECRET: the two surfaces are separate credentials.
PARENT_JWT_SECRET=change-me-in-every-environment
# The session lasts until explicit sign-out; 30 days is the cookie's ceiling.
PARENT_SESSION_TTL_SECONDS=2592000
# Explicit, never inferred from NODE_ENV. Set false only for local plain HTTP.
COOKIE_SECURE=true
PARENT_AUTH_RATE_LIMIT=5
PARENT_AUTH_RATE_TTL_MS=60000

# --- Parent PIN and Parent View elevation (Epic 1) ---
# Optional overrides; the API's pin-policy module holds the defaults shown.
# How long the PIN gate stays shut once the attempt ceiling is reached.
PIN_COOLDOWN_MS=900000
# One elevation token's life. Nothing in the web app refreshes it yet, so today
# Parent View ends after this long and the PIN is asked for again; the idle
# clock that refreshes while a parent is active arrives with Story 1.5.
# Must not exceed ELEVATION_CEILING_MS, or the API refuses to start.
ELEVATION_TTL_SECONDS=900
# The absolute ceiling from the PIN crossing; past it the PIN is required again.
ELEVATION_CEILING_MS=28800000

# --- Mail ---
# log (default) or http. An unknown value refuses to boot.
MAIL_TRANSPORT=log
MAIL_FROM=no-reply@example.test
MAIL_TIMEOUT_MS=10000
# Required when MAIL_TRANSPORT=http.
# MAIL_API_URL=https://api.example.test/v1/messages
# MAIL_API_KEY=
# Development and E2E only: the log transport also appends JSONL here.
# MAIL_LOG_FILE=
