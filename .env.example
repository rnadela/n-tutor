
# --- Runtime ---
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# --- Database (compose.yml maps postgres to host port 5433) ---
DATABASE_URL=postgresql://nts:nts@localhost:5433/nts?schema=public

# --- Admin ---
# Must be at least 32 characters and must not be left as this placeholder.
ADMIN_JWT_SECRET=change-me-in-every-environment
ADMIN_JWT_TTL_SECONDS=28800
ADMIN_SEED_EMAIL=operator@example.test
ADMIN_SEED_PASSWORD=change-me-too

# --- Rate limiting (defaults shown; optional) ---
API_RATE_LIMIT=300
API_RATE_TTL_MS=60000
AUTH_RATE_LIMIT=5
AUTH_RATE_TTL_MS=60000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# --- Parent sessions (Epic 1) ---
# Must differ from ADMIN_JWT_SECRET: the two surfaces are separate credentials.
PARENT_JWT_SECRET=change-me-in-every-environment
# The session lasts until explicit sign-out; 30 days is the cookie's ceiling.
PARENT_SESSION_TTL_SECONDS=2592000
# Explicit, never inferred from NODE_ENV. Set false only for local plain HTTP.
COOKIE_SECURE=true
PARENT_AUTH_RATE_LIMIT=5
PARENT_AUTH_RATE_TTL_MS=60000

# --- Parent PIN and Parent View elevation (Epic 1) ---
# Optional overrides; the API's pin-policy module holds the defaults shown.
# How long the PIN gate stays shut once the attempt ceiling is reached.
PIN_COOLDOWN_MS=900000
# One elevation token's life. Nothing in the web app refreshes it yet, so today
# Parent View ends after this long and the PIN is asked for again; the idle
# clock that refreshes while a parent is active arrives with Story 1.5.
# Must not exceed ELEVATION_CEILING_MS, or the API refuses to start.
ELEVATION_TTL_SECONDS=900
# The absolute ceiling from the PIN crossing; past it the PIN is required again.
ELEVATION_CEILING_MS=28800000

# --- Uncommitted parent input (Epic 1, Story 1.6) ---
# Optional overrides; the API's uncommitted-state-policy module holds the
# defaults shown. A non-numeric value for either refuses to boot.
# How long a saved slot of half-finished parent work lives. Measured from when
# the row was created and never extended by a later save, so an actively
# re-saved draft still expires on schedule.
UNCOMMITTED_STATE_TTL_MS=259200000
# The largest a saved payload may serialize to. Must stay below the 100KB
# request body limit, or the API refuses to start: a ceiling above it could
# never be reached, and an oversized payload would be refused by the framework
# rather than by the stated limit.
UNCOMMITTED_PAYLOAD_MAX_BYTES=65536

# --- Source Test capture (Epic 3, Story 3.2) ---
# Where normalized page images are written. Defaults to `.uploads` under the
# API's working directory. Each file's path is derived from its PageImage row
# id and never from anything the client sent, and nothing under this directory
# is ever served as a static file.
UPLOAD_ROOT=.uploads
# The largest single page upload the multipart layer will hold in memory, in
# bytes. Not the product rule — that is the 10-page ceiling, which lives in the
# API's source-test-policy module — but the bound one request may spend. A
# non-numeric value refuses to boot.
MAX_PAGE_BYTES=26214400

# --- Mail ---
# log (default) or http. An unknown value refuses to boot.
MAIL_TRANSPORT=log
MAIL_FROM=no-reply@example.test
MAIL_TIMEOUT_MS=10000
# Required when MAIL_TRANSPORT=http.
# MAIL_API_URL=https://api.example.test/v1/messages
# MAIL_API_KEY=
# Development and E2E only: the log transport also appends JSONL here.
# MAIL_LOG_FILE=

# --- AI provider (Epic 3, Story 3.5) ---
# fake (default) or openai. An unknown value refuses to boot, and a production
# boot must state one explicitly rather than fall into the fake — which is why
# this is commented out: a copied file that already "states" the fake would
# satisfy that guard and read every uploaded test with an invented answer.
# AI_TRANSPORT=openai
# Per-request ceiling in milliseconds. Ten photographed pages read as one
# document is a slow call by construction, so this is deliberately generous: a
# timeout shorter than the work turns a slow success into a retry that pays for
# the same tokens twice. A non-numeric or zero value refuses to boot.
AI_TIMEOUT_MS=180000
# How many times an upstream fault is tried before the job is failed, and the
# first backoff interval (each further attempt doubles it). Both must be
# positive whole numbers or the API refuses to start.
AI_MAX_ATTEMPTS=3
AI_RETRY_BASE_MS=500
# Development and test only: makes the fake transport fail instead of succeed.
# One of none (default), transport, schema, unusable. Read per call, so a test
# can drive one failure and then a success without restarting. An unknown value
# refuses the call.
AI_FAKE_FAILURE=none
# Development and test only: how many usable questions the fake transport puts
# on each page. One by default, which is deliberately thin against
# EXTRACTION_MIN_USABLE_PER_PAGE; raise it to drive a healthy Extraction. Read
# per call, like AI_FAKE_FAILURE. A non-numeric or zero value refuses the call.
AI_FAKE_QUESTIONS_PER_PAGE=1
# Required when AI_TRANSPORT=openai.
# OPENAI_API_KEY=
# The pinned model snapshot and price for the Extraction call class, in micros
# per million tokens. The defaults are the AD-8 aliases, and an alias is not a
# snapshot: each must be replaced with a resolved snapshot id before a
# production deploy, or a silent model change rewrites what the product does.
# Every other call class takes the same three variables under its own name.
# AI_MODEL_EXTRACTION=gpt-5.6-sol
# AI_PRICE_EXTRACTION_IN=1250000
# AI_PRICE_EXTRACTION_OUT=10000000

# --- Extraction jobs (Epic 3, Story 3.5) ---
# Whether this process runs the extraction worker. `true` or `false` only;
# anything else refuses to boot. Set false on an instance that should serve
# requests without claiming jobs.
EXTRACTION_WORKER_ENABLED=true
# How long the worker waits before looking again when it found no work, in
# milliseconds. A non-numeric or zero value refuses to boot.
EXTRACTION_POLL_MS=1000
# How long a claimed job is left alone before another worker may take it.
# Comfortably longer than the worst case of one run's whole retry sequence
# (AI_MAX_ATTEMPTS attempts at AI_TIMEOUT_MS each, plus AI_RETRY_BASE_MS
# backoff between them) — not just one call: the common reason a claim is old
# is a slow or retrying provider, not a dead worker, and a shorter value would
# hand the same pages to a second worker and pay for them twice. Raising
# AI_MAX_ATTEMPTS or AI_TIMEOUT_MS without raising this is refused at boot.
EXTRACTION_CLAIM_TIMEOUT_MS=600000
# How many usable questions a submitted page is expected to have yielded before
# the Extraction is taken at face value. Fewer than this per page and the parent
# is warned before generating — never blocked. A non-numeric or zero value
# refuses to boot; zero in particular would switch the warning off silently.
EXTRACTION_MIN_USABLE_PER_PAGE=2
