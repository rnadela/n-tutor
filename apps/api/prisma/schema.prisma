// Admin module entity cluster (AD-17, AD-25).
// `admin` is the sole writer of AdminUser, Subject, GradeLevel,
// SubjectGradeLevel and AdminAudit.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Operator credential store. Deliberately separate from ParentAccount (AD-25).
model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_user")
}

/// A Subject offered at upload time. Disabled, never deleted (UJ-4).
model Subject {
  id        String   @id @default(uuid())
  name      String
  /// Case-insensitive uniqueness key: lower(trim(name)).
  nameKey   String   @unique
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gradeLevels SubjectGradeLevel[]

  @@index([name])
  @@map("subject")
}

/// A Grade Level. Disabled, never deleted (UJ-4).
model GradeLevel {
  id        String   @id @default(uuid())
  name      String
  /// Case-insensitive uniqueness key: lower(trim(name)).
  nameKey   String   @unique
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects SubjectGradeLevel[]

  @@index([name])
  @@map("grade_level")
}

/// Availability of a Subject for a Grade Level. Third independent flag;
/// selectability is the conjunction of all three `enabled` columns.
model SubjectGradeLevel {
  id           String   @id @default(uuid())
  subjectId    String
  gradeLevelId String
  enabled      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  gradeLevel GradeLevel @relation(fields: [gradeLevelId], references: [id], onDelete: Restrict)

  @@unique([subjectId, gradeLevelId])
  @@index([gradeLevelId, enabled])
  @@map("subject_grade_level")
}

/// One row per admin write, in the same transaction as the write (AD-25).
/// `detail` is redacted metadata only — never child content (AD-20).
model AdminAudit {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  detail     Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit")
}

// Identity module entity cluster (AD-17).
// `identity` is the sole writer of ParentAccount and AccountTimezone. Every
// other module — `admin` included — reads and writes them through
// ParentAccountService, never through a Prisma delegate of its own.

/// The Account Tier assigned to a Parent Account. Admin-assigned only; there is
/// no self-serve path to any tier, and `Internal` is reachable only this way.
/// The figures each tier stands for live once, in `src/allowance/tiers.ts`.
enum AccountTier {
  Free
  Plus
  Family
  Internal

  @@map("account_tier")
}

/// The only credentialed account. Owns one Account Tier and one effective-dated
/// timezone history. Credentials arrive with Epic 1; v0 story 2.2 needs only
/// the identity, the tier, and the zone.
model ParentAccount {
  id          String      @id @default(uuid())
  email       String      @unique
  displayName String?
  tier        AccountTier @default(Free)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  timezones AccountTimezone[]

  @@map("parent_account")
}

/// Account timezone as an effective-dated history, never a mutable column
/// (AD-27). A period's window is computed from the zone in effect at that
/// period's start, so a zone change applies from the next boundary onward and
/// never re-slices a running period.
model AccountTimezone {
  id              String   @id @default(uuid())
  parentAccountId String
  /// An IANA zone name, resolved by the platform's `Intl` time-zone data.
  timezone        String
  effectiveFrom   DateTime
  createdAt       DateTime @default(now())

  parentAccount ParentAccount @relation(fields: [parentAccountId], references: [id], onDelete: Cascade)

  /// One zone per account per instant: two entries at the same `effectiveFrom`
  /// would make the zone in force at that instant ambiguous. Doubles as the
  /// lookup index for the history read.
  @@unique([parentAccountId, effectiveFrom])
  @@map("account_timezone")
}
