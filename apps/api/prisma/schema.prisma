// Admin module entity cluster (AD-17, AD-25).
// `admin` is the sole writer of AdminUser, Subject, GradeLevel,
// SubjectGradeLevel and AdminAudit.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Operator credential store. Deliberately separate from ParentAccount (AD-25).
model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_user")
}

/// A Subject offered at upload time. Disabled, never deleted (UJ-4).
model Subject {
  id        String   @id @default(uuid())
  name      String
  /// Case-insensitive uniqueness key: lower(trim(name)).
  nameKey   String   @unique
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gradeLevels SubjectGradeLevel[]
  /// Back-relation only. `sourcetest` is the sole writer of SourceTest
  /// (AD-17); `admin` never writes through this field.
  sourceTests SourceTest[]

  @@index([name])
  @@map("subject")
}

/// A Grade Level. Disabled, never deleted (UJ-4).
model GradeLevel {
  id        String   @id @default(uuid())
  name      String
  /// Case-insensitive uniqueness key: lower(trim(name)).
  nameKey   String   @unique
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects    SubjectGradeLevel[]
  /// Back-relation only. `identity` is the sole writer of StudentProfile
  /// (AD-17); `admin` never writes through this field.
  students    StudentProfile[]
  /// The same, for `sourcetest`'s per-upload Grade Level.
  sourceTests SourceTest[]

  @@index([name])
  @@map("grade_level")
}

/// Availability of a Subject for a Grade Level. Third independent flag;
/// selectability is the conjunction of all three `enabled` columns.
model SubjectGradeLevel {
  id           String   @id @default(uuid())
  subjectId    String
  gradeLevelId String
  enabled      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  gradeLevel GradeLevel @relation(fields: [gradeLevelId], references: [id], onDelete: Restrict)

  @@unique([subjectId, gradeLevelId])
  @@index([gradeLevelId, enabled])
  @@map("subject_grade_level")
}

/// One row per admin write, in the same transaction as the write (AD-25).
/// `detail` is redacted metadata only — never child content (AD-20).
model AdminAudit {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  detail     Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit")
}

// Identity module entity cluster (AD-17).
// `identity` is the sole writer of ParentAccount and AccountTimezone. Every
// other module — `admin` included — reads and writes them through
// ParentAccountService, never through a Prisma delegate of its own.

/// The Account Tier assigned to a Parent Account. Admin-assigned only; there is
/// no self-serve path to any tier, and `Internal` is reachable only this way.
/// The figures each tier stands for live once, in `src/allowance/tiers.ts`.
enum AccountTier {
  Free
  Plus
  Family
  Internal

  @@map("account_tier")
}

/// The only credentialed account. Owns one Account Tier and one effective-dated
/// timezone history. Credentials arrive with Epic 1; v0 story 2.2 needs only
/// the identity, the tier, and the zone.
model ParentAccount {
  id                String      @id @default(uuid())
  email             String      @unique
  displayName       String?
  tier              AccountTier @default(Free)
  /// argon2id. Nullable: accounts created before Epic 1 carry no credential and
  /// simply cannot sign in — reset never promotes them into one either.
  passwordHash      String?
  /// Bumped whenever every outstanding session for this account must stop being
  /// valid. The session token carries the epoch it was minted at, so a
  /// long-lived stateless cookie can still be revoked by a password reset.
  sessionEpoch      Int         @default(0)
  /// argon2id hash of the Parent PIN. Null until a PIN is first set; never
  /// returned by any read path and never selected by a shared field list.
  pinHash           String?
  /// Consecutive wrong PIN entries. A server-side column, not a client counter
  /// and not a throttler bucket (AD-33): the count has to survive the refresh
  /// the gate already expects, and a process restart with it.
  pinFailedAttempts Int         @default(0)
  /// When the PIN gate re-opens, or null when it is open. The lock lifts on the
  /// clock alone — a correct PIN never unlocks it early.
  pinLockedUntil    DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  timezones      AccountTimezone[]
  consents       AccountConsent[]
  passwordResets PasswordReset[]
  students       StudentProfile[]
  /// Source Tests opened on this account. `Restrict` from the other side: a
  /// Source Test is never destroyed as a side effect of an account removal.
  sourceTests    SourceTest[]
  /// Uncommitted parent work saved on this account. Cascades from here, like
  /// the consents and reset tokens above it: a row that was never committed is
  /// not something a deletion has to preserve, and leaves no tombstone.
  uncommitted    UncommittedState[]
  /// Back-relation only. `ai` is the sole writer of AiCall (AD-17, AD-20), and
  /// the edge is `Restrict` from the other side so a cost row never vanishes as
  /// a side effect of an account removal.
  aiCalls        AiCall[]
  /// Practice Tests generated on this account, and the generation jobs that
  /// produced them. `Restrict` from the other side on the Practice Test: a
  /// charged artifact is what the Generation Allowance is counted from, so it
  /// must never vanish as a side effect of an account removal.
  practiceTests  PracticeTest[]
  generationJobs GenerationJob[]

  @@map("parent_account")
}

/// A child under a Parent Account: a display name and exactly one Grade Level.
/// `identity` is its sole writer (AD-17) — nothing outside StudentProfileService
/// touches this delegate, and the Grade Level is read through `admin`'s
/// TaxonomyService rather than through a second reader of `grade_level`.
///
/// Archive is a nullable instant, not a boolean and not a delete: nothing is
/// copied, nothing is cascaded and nothing is removed, so a reference held by
/// id keeps resolving and history survives by construction. The timestamp
/// additionally records *when*, which Epic 8's deletion path and Epic 9's
/// active count both want.
model StudentProfile {
  id              String    @id @default(uuid())
  parentAccountId String
  displayName     String
  gradeLevelId    String
  /// Null while the profile is active. Set on archive; cleared on restore.
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /// `Restrict` on both sides: a profile is never destroyed as a side effect of
  /// something else being removed.
  parentAccount ParentAccount @relation(fields: [parentAccountId], references: [id], onDelete: Restrict)
  gradeLevel    GradeLevel    @relation(fields: [gradeLevelId], references: [id], onDelete: Restrict)

  /// Uncommitted parent work saved under this child. Cascades from here: a row
  /// that was never committed is not something a deletion has to preserve.
  uncommitted UncommittedState[]

  /// Source Tests photographed for this child. `Restrict` from the other side,
  /// like the profile's own relations: nothing here goes as a side effect.
  sourceTests SourceTest[]

  /// Practice Tests generated for this child, and the jobs that produced them.
  /// `Restrict` from the other side, for the same reason.
  practiceTests  PracticeTest[]
  generationJobs GenerationJob[]

  /// This child's runs at their released Practice Tests. Cascades from here,
  /// like `uncommitted`: an Attempt carries the clock and the child's own raw
  /// answers, and neither is something a deletion has to preserve.
  attempts Attempt[]

  /// The Explanations asked for under this child's binding. Cascades from here,
  /// like `attempts`: an Explanation is prose written for this child about their
  /// own run, and it goes with the run.
  explanations Explanation[]

  /// The list read and the selectable read are both scoped by account and
  /// filtered by archive state.
  @@index([parentAccountId, archivedAt])
  @@index([gradeLevelId])
  @@map("student_profile")
}

/// What a slot of uncommitted parent work is. The extension point AD-16
/// describes: a later epic adds one value and the payload shape that goes with
/// it. Story 1.6 ships the mechanism and declares no payload for any of them.
enum UncommittedStateKind {
  DraftEdit
  GradeOverride
  PartialUpload

  @@map("uncommitted_state_kind")
}

/// Uncommitted parent input, held server-side so a silently expired Parent View
/// does not destroy half-typed work (AD-16).
///
/// Three rules define the row:
///
/// - It is keyed to the Parent Account **and** the Student Profile it was
///   created under (AD-33). An account-scoped row alone would strand one
///   child's draft where a sibling is now operating the device.
/// - It lives 72 hours from `createdAt`, never extended by an update. An
///   actively re-saved slot must not become an indefinite store of a child's
///   schoolwork that no clock reaches.
/// - Both relations cascade: an uncommitted row never blocks a deletion and
///   leaves no tombstone behind it (AD-15/16). `StudentProfile`'s own
///   `Restrict` is deliberately not the precedent — nothing of substance is
///   lost when a row that was never committed goes with its profile.
///
/// The payload is opaque JSON with a declared ceiling and carries no bytes:
/// Page Images are `PageImage` rows under AD-15, referenced by id.
model UncommittedState {
  id               String               @id @default(uuid())
  parentAccountId  String
  studentProfileId String
  kind             UncommittedStateKind
  /// An opaque caller-supplied discriminator — a Practice Test id, say — so one
  /// kind can hold more than one slot. Non-null with a `''` default rather than
  /// nullable: a nullable column would let two rows silently occupy one slot,
  /// because SQL's unique index does not compare NULLs.
  scope            String               @default("")
  payload          Json
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  /// Created-at plus the TTL, written once and never moved by a later save.
  expiresAt        DateTime

  parentAccount  ParentAccount  @relation(fields: [parentAccountId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  /// The slot: one row per account, profile, kind and scope.
  @@unique([parentAccountId, studentProfileId, kind, scope])
  /// The sweep, and the expiry filter every read carries.
  @@index([expiresAt])
  @@map("uncommitted_state")
}

/// Append-only record of what the parent accepted and when. A new acceptance is
/// a new row; an existing row is never edited, so the version in force at the
/// moment of acceptance stays recoverable.
model AccountConsent {
  id              String   @id @default(uuid())
  parentAccountId String
  termsVersion    String
  noticeVersion   String
  acceptedAt      DateTime
  createdAt       DateTime @default(now())

  parentAccount ParentAccount @relation(fields: [parentAccountId], references: [id], onDelete: Cascade)

  @@index([parentAccountId])
  @@map("account_consent")
}

/// A single-use password-reset token. Only the hash is stored: the plaintext
/// exists solely in the emailed link.
model PasswordReset {
  id              String    @id @default(uuid())
  parentAccountId String
  tokenHash       String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  parentAccount ParentAccount @relation(fields: [parentAccountId], references: [id], onDelete: Cascade)

  @@index([parentAccountId])
  @@map("password_reset")
}

/// Account timezone as an effective-dated history, never a mutable column
/// (AD-27). A period's window is computed from the zone in effect at that
/// period's start, so a zone change applies from the next boundary onward and
/// never re-slices a running period.
model AccountTimezone {
  id              String   @id @default(uuid())
  parentAccountId String
  /// An IANA zone name, resolved by the platform's `Intl` time-zone data.
  timezone        String
  effectiveFrom   DateTime
  createdAt       DateTime @default(now())

  parentAccount ParentAccount @relation(fields: [parentAccountId], references: [id], onDelete: Cascade)

  /// One zone per account per instant: two entries at the same `effectiveFrom`
  /// would make the zone in force at that instant ambiguous. Doubles as the
  /// lookup index for the history read.
  @@unique([parentAccountId, effectiveFrom])
  @@map("account_timezone")
}

// Source Test module entity cluster (AD-17).
// `sourcetest` is the sole writer of SourceTest and PageImage, and the sole
// owner of image ingest. Nothing outside SourceTestService touches either
// delegate.

/// Where a Source Test stands. `Draft` is the only state page management acts
/// on; `Submitted` is terminal for this story — Story 3.4's legibility check
/// and Upload Allowance charge, and Story 3.5's Extraction, hang off it later.
enum SourceTestStatus {
  Draft
  Submitted

  @@map("source_test_status")
}

/// Where one Page Image stands. `Uploading` is the state the row is INSERTed
/// in, **before any byte is written** (AD-15): the row is the authority from
/// the first byte, so a directory scan never has to be. It leaves `Uploading`
/// only once ingest has sniffed, rotated and re-encoded the bytes (AD-28), so
/// no downstream consumer ever sees a format the model cannot read.
enum PageImageState {
  Uploading
  Ready

  @@map("page_image_state")
}

/// How confidently one photographed page could be read (AD-29).
///
/// A per-page verdict, never a whole-test pass/fail: the check names the page
/// that is blurry so the retake it offers can be scoped to that page alone.
/// `Low` is the only failing verdict, and it is advisory — proceeding over one
/// is always allowed, because the submit gate asserts the check *ran*, never
/// what it said.
enum PageLegibility {
  Low
  Medium
  High

  @@map("page_legibility")
}

/// One photographed paper test: 1–10 Page Images in an explicit order.
///
/// Three rules define the row:
///
/// - It is keyed to the Parent Account **and** the Student Profile it was
///   opened under. Every read and every write is scoped by the account, which
///   comes from the elevation token and never from the path or body (AD-18).
/// - It lives 72 hours from `createdAt` while it is a draft, never extended by
///   activity — the same single TTL the uncommitted-state mechanism runs on
///   (AD-16). The figure is stated once, in `uncommitted-state-policy.ts`.
/// - Both parent relations are `Restrict`: a Source Test is never destroyed as
///   a side effect of something else being removed. Epic 8 owns deletion and
///   expiry semantics deliberately, so nothing here sweeps or tombstones.
model SourceTest {
  id               String           @id @default(uuid())
  parentAccountId  String
  studentProfileId String
  status           SourceTestStatus @default(Draft)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  /// Created-at plus the one TTL, written once and never moved by activity.
  expiresAt        DateTime
  /// Null until submission; set once, in the same transaction as the status.
  submittedAt      DateTime?

  /// When the one batch legibility check ran over this exact page set (AD-29).
  ///
  /// Nullable because "not checked" is precisely the state the submit gate
  /// refuses. It is the whole gate: submission is refused while this is null
  /// and accepted whatever the verdicts say. Adding, retaking or deleting a
  /// page clears it along with every page's verdict, because the batch no
  /// longer covers the set that would be committed; reordering does not, since
  /// the verdicts hang off the page rows and move with them.
  legibilityCheckedAt DateTime?

  /// The classification, held as ids and never as copied labels: the names are
  /// resolved on read through `admin`'s TaxonomyService, exactly as a Student
  /// Profile resolves its Grade Level, so an Admin rename or disable changes
  /// what this row reads without writing it.
  ///
  /// Nullable because a draft opened before the columns existed has neither,
  /// and because "unset" is precisely the state the submit gate exists to
  /// refuse. The Grade Level is seeded from the Student Profile's on open and
  /// is overridable per upload; the Subject starts unset.
  subjectId    String?
  gradeLevelId String?

  parentAccount  ParentAccount  @relation(fields: [parentAccountId], references: [id], onDelete: Restrict)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)

  /// `Restrict`, like both relations above: a Source Test is never destroyed as
  /// a side effect of something else being removed, and taxonomy rows are
  /// disabled rather than deleted in any case.
  subject    Subject?    @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  gradeLevel GradeLevel? @relation(fields: [gradeLevelId], references: [id], onDelete: Restrict)

  /// Cascade in this direction only: a page has no existence apart from the
  /// Source Test it is a page of.
  pages PageImage[]

  /// The one Extraction job and the one Extraction, both owned by `extraction`
  /// (AD-17) and both Cascade: neither has any existence apart from the Source
  /// Test they are a reading of.
  extractionJob ExtractionJob?
  extraction    Extraction?

  /// The Practice Tests generated from this Source Test's Extraction, and the
  /// jobs that produced them. `Cascade`: a Practice Test is a reading of this
  /// upload and has no existence apart from it. The *charge* it carries is
  /// already spent and is never refunded — deleting a Source Test is not a
  /// refund path, and no such path exists.
  practiceTests  PracticeTest[]
  generationJobs GenerationJob[]

  /// The resume read: the account's live draft for one child.
  ///
  /// A partial unique index enforces that there is at most **one** of them:
  /// `("parentAccountId", "studentProfileId") WHERE status = 'Draft'`. Prisma's
  /// schema language cannot express a partial index, so it is written by hand
  /// in the migration; without it "one draft per child" would rest on a read
  /// followed by a write, which two concurrent opens slip straight through.
  @@index([parentAccountId, studentProfileId, status])
  /// The derived Upload Allowance count (AD-14): this account's Submitted rows
  /// whose `submittedAt` falls in the period window. Indexed because the count
  /// *is* the charge — there is no counter column to read instead — so it runs
  /// on every surface that shows an allowance, and its three terms are exactly
  /// the columns in this order: equality, equality, then the range.
  @@index([parentAccountId, status, submittedAt])
  /// The expiry filter every read carries.
  @@index([expiresAt])
  /// The Grade Level a Source Test was classified under: the axis Epic 4's
  /// generation and Epic 7's Mastery read across.
  @@index([gradeLevelId])
  @@map("source_test")
}

/// One page of a Source Test, at a contiguous ordinal.
///
/// `@@unique([sourceTestId, ordinal])` is what makes "contiguous 1..N" a
/// constraint rather than an intention. Reorder and delete rewrite the ordinals
/// inside one transaction — in two phases, because a straight rewrite collides
/// against this index mid-statement — and never re-read or re-process a byte.
///
/// `storagePath` is derived from `id` alone and never from client input; that
/// is the path-traversal control (AD-15). The columns below the state are null
/// exactly while the row is `Uploading`, and are written by ingest in the same
/// update that promotes it to `Ready`.
model PageImage {
  id           String          @id @default(uuid())
  sourceTestId String
  ordinal      Int
  state        PageImageState  @default(Uploading)
  /// Derived from `id`. Never supplied or influenced by the client, and never
  /// served as a static file.
  storagePath  String?
  /// The stored format — always the re-encoded one, never what was declared.
  mimeType     String?
  width        Int?
  height       Int?
  byteSize     Int?
  /// This page's own readability verdict from the one batch check (AD-29).
  /// Null means the check has not run over the current page set — cleared
  /// whenever the set or this page's bytes change.
  legibility   PageLegibility?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  sourceTest SourceTest @relation(fields: [sourceTestId], references: [id], onDelete: Cascade)

  @@unique([sourceTestId, ordinal])
  @@index([sourceTestId])
  @@map("page_image")
}

// `ai` is the sole owner and sole writer of AiCall (AD-17, AD-20). No domain
// module constructs a provider client and none writes a cost row.

/// Which class of provider call a cost row belongs to. Each class carries its
/// own pinned model snapshot and its own price (AD-8, AD-17); the enum is the
/// list of classes the product has, not the list it uses today.
enum AiCallClass {
  Extraction
  Generation
  Grading
  Explanation
  Legibility
  TopicNormalization

  @@map("ai_call_class")
}

/// One completed provider call: what it cost, how long it took, and nothing
/// about what it said (AD-20). No image byte and no extracted Question content
/// ever reaches this table — identifiers, counts and money only.
model AiCall {
  id              String      @id @default(uuid())
  parentAccountId String
  callClass       AiCallClass
  /// The pinned snapshot actually sent, recorded per row: a re-pin must not
  /// rewrite the history of what previous calls were billed for.
  model           String
  inputTokens     Int
  outputTokens    Int
  /// Integer micros. A money column that is a float is a money column that
  /// drifts.
  costMicros      Int
  latencyMs       Int
  /// Request-scoped (AD-20), so a worker-run job has none: the job id is the
  /// handle there, and this column stays null.
  correlationId   String?
  createdAt       DateTime    @default(now())

  /// `Restrict`: a cost row must never vanish as a side effect of an account
  /// removal.
  parentAccount ParentAccount @relation(fields: [parentAccountId], references: [id], onDelete: Restrict)

  @@index([parentAccountId, createdAt])
  @@index([createdAt])
  @@map("ai_call")
}

// `extraction` is the sole owner and sole writer of every table below. It reads
// Page Image bytes through SourceTestService and never through a Prisma
// delegate of its own (AD-17, AD-15, AD-28).

/// Where one Extraction job stands. `Queued` and stale `Running` rows are what
/// a claim pass looks at; `Succeeded` and `Failed` are terminal until the job
/// is re-enqueued, which returns the one row to `Queued` rather than adding a
/// second.
enum ExtractionJobStatus {
  Queued
  Running
  Succeeded
  Failed

  @@map("extraction_job_status")
}

/// Whose fault an AI failure was (AD-31). An `UpstreamFault` is the provider's
/// — transport, timeout, non-OK, schema-invalid payload, post-hoc violation —
/// and is retryable, except when the provider refused the request outright
/// (a bad key, a model the account cannot use): still the provider's fault,
/// but a retry would only buy the same refusal, so that case alone carries
/// `retryable = false` on the job row. A `ClientFault` is the input's: every
/// page uninterpretable is terminal, and a retry would only spend the same
/// money on the same photos.
enum AiFailureKind {
  UpstreamFault
  ClientFault

  @@map("ai_failure_kind")
}

/// The three formats a question may take. Exactly one per Question, enforced by
/// deterministic post-hoc validation in code and never trusted from the payload
/// (AD-30).
enum QuestionFormat {
  MultipleChoice
  FillInTheBlank
  ShortAnswer

  @@map("question_format")
}

/// The model's own self-assessment, carried per field where AD-30 requires one.
/// It is evidence, never a verdict: `usable` is computed from it in code.
enum ExtractionConfidence {
  Low
  Medium
  High

  @@map("extraction_confidence")
}

/// What a shared, cross-page piece of context is. Stored once, carrying the page
/// range it occupies, and pointed at by every question that depends on it.
enum ExtractedContextKind {
  Passage
  DataTable

  @@map("extracted_context_kind")
}

/// Why a region could not be read. Recorded rather than guessed at.
enum UninterpretableKind {
  Diagram
  Handwriting
  Cropped
  Other

  @@map("uninterpretable_kind")
}

/// The queue row. The substrate is this table in the application database
/// (AD-5): it is written inside `submit`'s own transaction, so a Submitted
/// Source Test with no job is unreachable and a refused submit leaves none.
///
/// `sourceTestId` is unique: there is exactly one job per Source Test, so a
/// re-run returns this row to `Queued` rather than adding a second.
model ExtractionJob {
  id            String              @id @default(uuid())
  sourceTestId  String              @unique
  status        ExtractionJobStatus @default(Queued)
  /// How many claim passes have taken this row. Incremented by the claim, not
  /// by the run, so a worker that died mid-run still counts its attempt.
  attempts      Int                 @default(0)
  /// When the current claim was taken, or null when the row is not `Running`.
  /// A `Running` row whose lock has outlived the claim timeout is stale and may
  /// be claimed again.
  lockedAt      DateTime?
  failureKind   AiFailureKind?
  /// A message **constant** from this module's policy file. Never a provider
  /// string, which could carry content (AD-20).
  failureReason String?
  /// Whether a re-run could plausibly succeed. False for a client fault, which
  /// is what a later retake prompt reads.
  retryable     Boolean             @default(false)
  completedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  sourceTest SourceTest @relation(fields: [sourceTestId], references: [id], onDelete: Cascade)

  /// The claim pass's own index: `Queued` first, oldest first.
  @@index([status, createdAt])
  @@map("extraction_job")
}

/// The persisted reading of one Source Test: a document that outlives the
/// photographs it came from. Nothing about reading it back touches a Page Image
/// row or a stored byte, which is what makes Epic 8's 90-day image expiry safe.
model Extraction {
  id           String   @id @default(uuid())
  sourceTestId String   @unique
  /// How many pages were read as one document. Stored rather than counted from
  /// `page_image`, for exactly the reason above.
  pageCount    Int
  completedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sourceTest SourceTest @relation(fields: [sourceTestId], references: [id], onDelete: Cascade)

  contexts        ExtractedContext[]
  questions       ExtractedQuestion[]
  uninterpretable UninterpretableRegion[]

  @@map("extraction")
}

/// A passage or data table shared across pages, stored **once** with the page
/// range it occupies. Every question that depends on it points here, including
/// questions on later pages — that is the cross-page context the epic requires.
model ExtractedContext {
  id               String               @id @default(uuid())
  extractionId     String
  ordinal          Int
  kind             ExtractedContextKind
  /// A validated rich-text segment array (AD-32), never a plain string.
  body             Json
  startPageOrdinal Int
  endPageOrdinal   Int
  createdAt        DateTime             @default(now())

  extraction Extraction          @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  questions  ExtractedQuestion[]

  @@unique([extractionId, ordinal])
  @@map("extracted_context")
}

/// One extracted Question: exactly one Format, at least one Topic, and a
/// `usable` flag **computed in code** from the declared dependency on an
/// uninterpretable region and the self-assessed confidence — never read from the
/// payload (AD-30).
model ExtractedQuestion {
  id                       String               @id @default(uuid())
  extractionId             String
  ordinal                  Int
  pageOrdinal              Int
  format                   QuestionFormat
  /// A validated rich-text segment array (AD-32).
  prompt                   Json
  confidence               ExtractionConfidence
  dependsOnUninterpretable Boolean
  /// Derived, never declared. Story 3.6 warns on the count of these; Epic 4
  /// generates from them and from nothing else.
  usable                   Boolean
  contextId                String?
  createdAt                DateTime             @default(now())

  extraction Extraction        @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  /// `SetNull` rather than `Cascade`: a context removed must not silently take
  /// the questions that referenced it with it.
  context    ExtractedContext? @relation(fields: [contextId], references: [id], onDelete: SetNull)

  choices ExtractedChoice[]
  topics  ExtractedTopicLabel[]

  @@unique([extractionId, ordinal])
  @@index([extractionId, usable])
  /// The `SetNull` edge's own index. Without it every context removal scans
  /// every extracted question to find the rows it must null out.
  @@index([contextId])
  @@map("extracted_question")
}

/// One option of a Multiple Choice question, in the order it was printed.
model ExtractedChoice {
  id         String   @id @default(uuid())
  questionId String
  ordinal    Int
  /// A validated rich-text segment array (AD-32).
  body       Json
  createdAt  DateTime @default(now())

  question ExtractedQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, ordinal])
  @@map("extracted_choice")
}

/// A Topic as the model read it, stored **raw**. Canonicalization is Epic 7's
/// (AD-11), and doing it here would destroy the evidence it works from.
model ExtractedTopicLabel {
  id         String               @id @default(uuid())
  questionId String
  label      String
  confidence ExtractionConfidence
  createdAt  DateTime             @default(now())

  question ExtractedQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("extracted_topic_label")
}

/// Content the model could not interpret, recorded rather than guessed at. A
/// question that depends on one is stored `usable = false`.
model UninterpretableRegion {
  id           String              @id @default(uuid())
  extractionId String
  pageOrdinal  Int
  kind         UninterpretableKind
  createdAt    DateTime            @default(now())

  extraction Extraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)

  @@index([extractionId])
  @@map("uninterpretable_region")
}

// `practicetest` is the sole owner and sole writer of every table below
// (AD-17). It reads the persisted Extraction through `ExtractionReader` and
// never through a Prisma delegate of its own, and it never touches a Page Image
// row or a stored byte — which is what makes regeneration survive Epic 8's
// 90-day image expiry.

/// Where one generated Practice Test stands.
///
/// `Draft` is where every one of them lands, and reaching it is what charges
/// the Generation Allowance — once, durably, carried on the row as `chargedAt`.
/// `Released` and `Discarded` are Story 4.5's transitions; neither refunds.
enum PracticeTestStatus {
  Draft
  Released
  Discarded

  @@map("practice_test_status")
}

/// Where one generation job stands.
///
/// `PartiallyComplete` is a real, first-class outcome rather than a flavour of
/// failure: drafts are committed and charged as they land, so a job that
/// produced three of five requested tests charged three and kept three. It is
/// the one status that is neither a success nor a failure, and it exists
/// because collapsing it into either would misreport what the parent was
/// charged.
enum GenerationJobStatus {
  Queued
  Running
  Succeeded
  PartiallyComplete
  Failed

  @@map("generation_job_status")
}

/// The generation queue row. The substrate is this table in the application
/// database (AD-5), mirroring `extraction_job`'s claim and fence mechanics.
///
/// Unlike `extraction_job` there is **no** unique key on `sourceTestId`: a
/// generation job is one per *request*, and a parent generating again (Story
/// 4.2) is a second job rather than a reset of the first. That difference in
/// uniqueness is why this is a second table rather than a generalized one.
model GenerationJob {
  id               String              @id @default(uuid())
  parentAccountId  String
  sourceTestId     String
  studentProfileId String
  /// What was actually accepted, already clamped to the remaining Generation
  /// Allowance server-side. Never what the client asked for.
  requestedCount   Int
  /// The one Topic this request asked the drafts to concentrate on, held in the
  /// **Extraction's own spelling** — resolved at request time against the labels
  /// the Extraction actually carries, never the spelling the client sent. Null
  /// for an unweighted request, which is every request Story 4.1 could make and
  /// still the default one.
  ///
  /// It is stored rather than recomputed because the request, the run and the
  /// progress read all happen at different times: the job has to still know what
  /// it was asked for when a worker picks it up, and a parent returning to the
  /// URL has to read the request they actually made.
  weightedTopic    String?
  /// How many drafts have landed and been charged. Incremented inside the same
  /// fenced transaction that inserts each Practice Test, so the two figures
  /// cannot disagree.
  producedCount    Int                 @default(0)
  status           GenerationJobStatus @default(Queued)
  /// How many claim passes have taken this row. Incremented by the claim, not
  /// by the run, so a worker that died mid-run still counts its attempt.
  attempts         Int                 @default(0)
  /// When the current claim was taken, or null when the row is not `Running`.
  lockedAt         DateTime?
  failureKind      AiFailureKind?
  /// A message **constant** from this module's policy file. Never a provider
  /// string and never a fragment of generated content (AD-20).
  failureReason    String?
  retryable        Boolean             @default(false)
  completedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  parentAccount  ParentAccount  @relation(fields: [parentAccountId], references: [id], onDelete: Restrict)
  // Restrict, not Cascade: a job's PracticeTest rows may already be charged
  // (AD-14), and a cascaded delete would silently uncharge them by deleting
  // the derived count's own rows out from under it.
  sourceTest     SourceTest     @relation(fields: [sourceTestId], references: [id], onDelete: Restrict)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)

  practiceTests PracticeTest[]

  /// The claim pass's own index: `Queued` first, oldest first.
  @@index([status, createdAt])
  /// The progress read: this account's jobs for one Source Test, newest first.
  @@index([parentAccountId, sourceTestId, createdAt])
  @@map("generation_job")
}

/// One generated Practice Test.
///
/// `chargedAt` is the durable marker AD-14 requires: the Generation Allowance
/// is *derived* by counting rows whose `chargedAt` falls inside the account's
/// period window, never by decrementing a counter column. It is written in the
/// same transaction that inserts the row and never rewritten — a Practice Test
/// charges on first reaching draft and never again, and neither a discard nor a
/// deletion refunds it.
model PracticeTest {
  id               String             @id @default(uuid())
  parentAccountId  String
  sourceTestId     String
  studentProfileId String
  generationJobId  String
  status           PracticeTestStatus @default(Draft)
  /// Its place within the job that produced it, 1-based — "draft 2 of 5".
  ordinal          Int
  /// How many Questions it holds, stored rather than counted so a progress
  /// read never has to join.
  questionCount    Int
  /// When the Generation Allowance was spent on this row. Nullable only so the
  /// column can exist; every row this module writes sets it.
  chargedAt        DateTime?
  /// The countdown the parent configured, in whole minutes, or null for none.
  ///
  /// `null` **is** off: the timer is optional and off by default (FR-15), so
  /// every row that was never configured — including every row written before
  /// this column existed — already reads as untimed with no backfill and no
  /// second `enabled` flag that could disagree with a duration.
  ///
  /// Minutes rather than seconds because minutes are what a parent enters; a
  /// unit converted twice is a unit two surfaces can disagree about. Epic 5
  /// derives a deadline from it.
  ///
  /// Editable at any point up to release and never after — a property of the
  /// statement that writes it, which carries `status: 'Draft'` in its `where`,
  /// not of any screen. A timer changed after release would retroactively
  /// change how expiry graded past Attempts.
  ///
  /// No index: it is only ever read as part of a row already being read by
  /// primary key.
  timerMinutes     Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  parentAccount  ParentAccount  @relation(fields: [parentAccountId], references: [id], onDelete: Restrict)
  // Restrict, not Cascade: this row may already be charged (AD-14) — "neither
  // a discard nor a deletion refunds it" above means this table's own rows too,
  // not only its owning Source Test's.
  sourceTest     SourceTest     @relation(fields: [sourceTestId], references: [id], onDelete: Restrict)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  generationJob  GenerationJob  @relation(fields: [generationJobId], references: [id], onDelete: Cascade)

  questions PracticeTestQuestion[]
  attempts  Attempt[]

  @@unique([generationJobId, ordinal])
  /// The one index the allowance count reads: this account's charged rows
  /// inside a period window.
  @@index([parentAccountId, chargedAt])
  @@index([sourceTestId])
  @@index([studentProfileId])
  @@map("practice_test")
}

/// One generated Question. Exactly one Format, at least one Topic, and every
/// text field a validated rich-text segment array (AD-32) — a fraction is
/// structure, never the glyph "1/2".
model PracticeTestQuestion {
  id             String         @id @default(uuid())
  practiceTestId String
  ordinal        Int
  format         QuestionFormat
  /// A validated rich-text segment array (AD-32).
  prompt         Json
  /// The correct free-text answer, for every format but MultipleChoice, where
  /// the answer is the one choice flagged correct and this is null.
  answer         Json?
  createdAt      DateTime       @default(now())

  practiceTest PracticeTest @relation(fields: [practiceTestId], references: [id], onDelete: Cascade)

  choices PracticeTestChoice[]
  topics  PracticeTestQuestionTopic[]
  answers Answer[]
  grades  QuestionGrade[]
  /// `explanation`'s rows, back-related here because Prisma requires both sides
  /// of a relation to be named. It is a relation and not a licence: nothing in
  /// `practicetest` reads or writes an Explanation (AD-17).
  explanations Explanation[]

  @@unique([practiceTestId, ordinal])
  @@map("practice_test_question")
}

/// One option of a generated Multiple Choice question, in the order it is to be
/// shown. Exactly one of a question's choices carries `isCorrect`, enforced by
/// deterministic post-hoc validation in code and never trusted because the
/// payload parsed (AD-30).
model PracticeTestChoice {
  id         String   @id @default(uuid())
  questionId String
  ordinal    Int
  /// A validated rich-text segment array (AD-32).
  body       Json
  isCorrect  Boolean
  createdAt  DateTime @default(now())

  question PracticeTestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, ordinal])
  @@map("practice_test_choice")
}

/// A Topic on a generated Question, stored **raw** and uncanonicalized.
/// Canonicalization is Epic 7's (AD-11), and doing it here would destroy the
/// evidence it works from.
model PracticeTestQuestionTopic {
  id         String   @id @default(uuid())
  questionId String
  label      String
  createdAt  DateTime @default(now())

  question PracticeTestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("practice_test_question_topic")
}

/// One run at a released Practice Test by the child it was released for.
///
/// The child's answers live in the browser while they work (AD-26); what lives
/// here is the part the browser may not own — **the clock**. Two instants and a
/// submission marker are the whole of its substance until the work is handed in.
///
/// - `startedAt` is the server's clock at the moment the Attempt began, written
///   once. Nothing in a request body sets or influences it.
/// - `expiresAt` is the server's one statement of when this Attempt ended:
///   `startedAt` plus the Practice Test's `timerMinutes` snapshotted at start,
///   or null for an untimed test. **Written once and never moved** — never
///   extended, never paused, never recomputed — because a timer that could be
///   moved would retroactively change how a past Attempt graded, and expiry is
///   what decides `unanswered` from `incorrect` downstream.
/// - `submittedAt` is null while the Attempt is open. At most one Attempt per
///   Practice Test and profile is ever open at a time: a re-open resumes the
///   latest row rather than inserting a second one, and a retake is refused
///   while the latest row is still open. Several rows per test and profile do
///   exist — one per run — which is exactly what `ordinal` plus the unique index
///   below expresses.
/// - `expired` records the comparison the server itself made at submit, against
///   its own clock and its own column. A client claim about expiry is never
///   stored, because a browser that could claim it could buy time.
///
/// Both relations cascade: an Attempt never blocks a deletion and leaves no
/// tombstone behind it. No grade column of any kind — grading is Epic 5's later
/// stories, and a column here would be a half-built one.
model Attempt {
  id               String    @id @default(uuid())
  practiceTestId   String
  /// The owning account, denormalized so every student-scoped statement can
  /// carry all three ids in one `where`. A plain column rather than a relation:
  /// `PracticeTest`'s own `parentAccount` is `Restrict` because the row may be
  /// charged (AD-14), and a second, cascading edge to the same account would
  /// contradict it.
  parentAccountId  String
  studentProfileId String
  /// This Attempt's place in the child's runs at this Practice Test, 1-based.
  /// A first run is 1; every retake is the latest ordinal plus one, written by
  /// `PracticeTestService.startRetake` and by nothing else. The resume read takes
  /// the highest, so the run a child is on is the run they get back.
  ///
  /// **`ordinal === 1` is the one definition of "counts toward Mastery"**, stated
  /// in `grading/mastery-eligibility.ts` and nowhere else: a retake is excluded by
  /// being a later run rather than by a filter at each call site (FR-26, Epic 7).
  /// There is no per-Attempt Question order column and no shuffle — every run of a
  /// released test presents the same Questions in the same stored order.
  ordinal          Int
  /// The server's clock when the Attempt began. Written once.
  startedAt        DateTime
  /// `startedAt + timerMinutes`, or null for an untimed test. Written once and
  /// never moved.
  expiresAt        DateTime?
  /// The server's clock when the work was handed in, or null while it is open.
  submittedAt      DateTime?
  /// Whether the server's own clock was past `expiresAt` when the submission
  /// arrived. Decided server-side, at submit, and never sent up.
  expired          Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  practiceTest   PracticeTest   @relation(fields: [practiceTestId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  answers Answer[]
  /// `grading`'s rows, back-related here because Prisma requires both sides of a
  /// relation to be named. It is a relation and not a licence: nothing in
  /// `practicetest` reads or writes a grade (AD-6, AD-17).
  grades  QuestionGrade[]
  /// `explanation`'s rows, back-related for the reason `grades` is. Cascade from
  /// here: an Explanation is a reading of this run and has no existence apart
  /// from it. The *charge* it carries is already spent and is never refunded.
  explanations Explanation[]

  /// One row per child per run at a Practice Test.
  @@unique([practiceTestId, studentProfileId, ordinal])
  /// The open-Attempt lookup: this child's Attempts, filtered by submission.
  @@index([studentProfileId, submittedAt])
  /// The index the student list (Story 5.1) reads: this test's Attempts, and
  /// whether any of them is still open.
  @@index([practiceTestId, submittedAt])
  @@map("attempt")
}

/// What the child answered on one Question of one Attempt, as raw text.
///
/// Raw, and nothing else. There is **no grade column and no correctness flag**:
/// what a blank means and whether an answer is right are Stories 5.4–5.5, and a
/// nullable `isCorrect` here would be a column two stories could disagree about.
/// A Question the child left blank has no row at all.
///
/// `@db.Text` because a Short Answer is prose, not a label. Both relations
/// cascade, for the reason `Attempt`'s do.
model Answer {
  id         String   @id @default(uuid())
  attemptId  String
  questionId String
  /// Exactly what the child typed or chose, untouched. Text on the wire and
  /// text in the column: no fraction is parsed, normalized or judged here.
  value      String   @db.Text
  createdAt  DateTime @default(now())

  attempt  Attempt              @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question PracticeTestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /// One answer per Question per Attempt.
  @@unique([attemptId, questionId])
  @@map("answer")
}

// `grading` is the sole owner and sole writer of every table below (AD-6,
// AD-17). It reads Practice Test rows through `practicetest`'s own service and
// never writes one: the module arrow is `grading -> practicetest` and is never
// reversed, which is why a grade lives here rather than as a column on a table
// `practicetest` owns.

/// What one Question of one Attempt came to.
///
/// **Four literals, because FR-37 fixes four**, and they are not this schema's to
/// negotiate: `Correct` and `Incorrect` are the two verdicts, `Unanswered` is a
/// blank on an Attempt handed in before its time ran out, and `Ungraded` is a
/// grading *failure* — an answer nothing could judge — and never a pending state.
///
/// What must never appear is a fifth member. There is no `Pending` and no
/// `Queued`: absence already carries every "no verdict yet" this domain has, and a
/// pending literal would be a second way to say one of them that every read would
/// then have to tell apart from the first.
///
/// **Absence says exactly one thing: "nothing has judged this yet".** It used to say
/// two — that, or a blank on an Attempt the server judged **expired**, which Story
/// 5.4 deliberately wrote no row for. Story 5.5 grades that second case `Incorrect`,
/// so on a submitted Attempt every presented Question carries a row and absence is
/// back to one reading. Neither reading is "graded and the result is pending", which
/// is the state this enum must never be able to express.
///
/// **All four are written now, and each by one rule** (Story 5.5). `Correct` and
/// `Incorrect` come from the deterministic Multiple Choice comparison — the child's
/// chosen ordinal against the option flagged correct — from a blank on an Attempt the
/// server judged expired, which is always `Incorrect`, and from a provider's verdict
/// on an answered Fill-in-the-Blank or Short Answer. `Unanswered` is written only for
/// a blank on a manually submitted Attempt the server judged unexpired, exactly as
/// Story 5.4 wrote it. `Ungraded` is written only where grading *failed* — an input
/// fault, a provider refusal, an exhausted upstream retry, or a payload the post-hoc
/// pass kept rejecting — and never to mean "queued": it is the one state a later read
/// re-asks for, and it is excluded from the score's denominator rather than counted
/// against the child.
enum GradeState {
  Correct
  Incorrect
  Unanswered
  Ungraded

  @@map("grade_state")
}

/// Where one Question of one Attempt stands, once something has judged it.
///
/// **A table of its own rather than a column on `Answer`**, for two reasons that
/// each would be enough. A blank Question has no `Answer` row at all — that is a
/// promise `Answer`'s own doc makes, and keeping it is what leaves raw answers
/// raw — so a blank would have nothing to hang a grade on. And `Answer` is
/// `practicetest`'s table while grade state is `grading`'s (AD-6, AD-17): a grade
/// column over there would be a second module writing rows it does not own.
///
/// The unique key says what a grade is a fact *about*: one (Attempt, Question)
/// pair, whether or not an answer exists for it. Nothing is derived at read time
/// from an empty answer field — FR-37 forbids exactly that, because a blank on an
/// Attempt whose time ran out grades `Incorrect` while a blank on one handed in
/// early grades `Unanswered`, and the empty field looks identical in both.
///
/// **Every presented Question of a submitted Attempt carries a row** as of Story
/// 5.5, so a missing row no longer means "a blank on an expired Attempt" — it means
/// only "nothing has judged this yet", which is the one thing `resolveUngraded`
/// treats exactly as it treats a stored `Ungraded`.
///
/// There is still no score column: a score is a count over these rows and FR-37
/// fixes how it is counted, so storing it would be a second denominator to keep in
/// step with the first.
///
/// Both relations cascade, for the reason `Attempt`'s and `Answer`'s do.
model QuestionGrade {
  id         String     @id @default(uuid())
  attemptId  String
  questionId String
  /// One of FR-37's four literals. All four are written, each by its own rule —
  /// the enum's own doc states which.
  state      GradeState
  /// Why a provider judged this answer the way it did, in one or two plain
  /// sentences addressed to the parent.
  ///
  /// **A column and not a log line**, because it is the evidence a parent decides
  /// an FR-25 override on: a rationale that lived only in a log would be a reason
  /// nobody the decision belongs to can read. It is null for a deterministic
  /// Multiple Choice verdict, for `Unanswered` and for `Ungraded`, because none of
  /// those is a judgement a provider explained. `@db.Text` for the reason
  /// `Answer.value` is: it is prose, not a label.
  rationale  String?    @db.Text
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  attempt  Attempt              @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question PracticeTestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /// One grade per Question per Attempt. A second row for the same pair would be
  /// two answers to one question, and the losing writer is refused by the index
  /// rather than by a check somebody has to remember to make.
  @@unique([attemptId, questionId])
  /// The read every later story makes: one Attempt's grades, whole.
  @@index([attemptId])
  @@map("question_grade")
}

/// One Explanation of one Question, written for the child who sat that Attempt.
///
/// **The row is the cache and the row is the charge.** The unique key
/// `(attemptId, questionId, studentProfileId)` *is* the cache key: the first ask
/// generates and writes, and every later ask for the same three ids finds this row
/// and makes no provider call, counts no allowance and writes nothing. There is no
/// second lookup table and no expiry — an Explanation of work already done does not
/// go stale.
///
/// `chargedAt` is the Explanation Allowance (AD-14), exactly as `PracticeTest`'s is
/// the Generation one: counting rows with a `chargedAt` inside a period window *is*
/// the usage, so there is no counter column, no reset job, no decrement and no
/// refund. It is **nullable** deliberately — Story 6.4's free regeneration needs
/// somewhere to opt out of the charge, and a null there is "this row cost nothing"
/// rather than "this row is not finished".
///
/// `parentAccountId` is a plain column rather than a relation, for the reason
/// `Attempt`'s is: the account edge on a charged row would have to be `Restrict`
/// to keep a charge from being deleted out from under the count, which contradicts
/// the cascading edges the child-scoped rows beside it carry.
///
/// `body` holds `RichText` segments (AD-32), never a flat string: an Explanation is
/// generated prose that talks about fractions, and a glyph cannot be read aloud.
model Explanation {
  id               String   @id @default(uuid())
  /// Whose charge this is. Denormalized so the allowance count is one statement
  /// over one index and never a join across the Attempt.
  parentAccountId  String
  studentProfileId String
  attemptId        String
  questionId       String
  /// The explanation prose, as stored `RichText` segments (AD-32).
  body             Json
  /// When the Explanation Allowance was spent on this row, or null for a row that
  /// cost nothing. Written once, by the transaction that writes the row.
  chargedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  attempt        Attempt        @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       PracticeTestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  flags          ExplanationFlag[]

  /// The cache key, as a constraint rather than as an intention: two rows for one
  /// (Attempt, Question, child) would be two explanations of one thing, and the
  /// losing writer is refused by the index rather than by a check somebody has to
  /// remember to make.
  @@unique([attemptId, questionId, studentProfileId])
  /// The one index the allowance count reads: this account's charged rows inside a
  /// period window. Equality then range, exactly as `practice_test`'s is.
  @@index([parentAccountId, chargedAt])
  @@map("explanation")
}

/// Who raised a flag against an Explanation.
///
/// **Both members are declared now, and only one of them is written yet.** Story
/// 6.2 implements the parent route; the student route is Story 6.3's. Declaring
/// `Student` here makes that story a code path rather than an enum migration — and
/// an enum value a Postgres migration adds cannot be added inside the same
/// transaction that first uses it, which is a cost paid once for nothing.
///
/// The origin is **part of the identity of a flag**, not a label on it: a parent
/// and a child who each flag the same Explanation are two people raising a concern
/// and must not overwrite each other, while one person pressing twice is one
/// concern. That is what `@@unique([explanationId, origin])` below says.
enum ExplanationFlagOrigin {
  Parent
  Student

  @@map("explanation_flag_origin")
}

/// What a parent decided about a concern their **child** raised.
///
/// Two members and no third. `Confirmed` is the parent agreeing that the
/// Explanation is bad, which is what puts it in front of an operator; `Dismissed` is
/// the parent reading the same prose and judging it fine. There is no `Pending`
/// member, because "nobody has decided yet" is the absence of a disposition and not
/// a decision — a third member would make an awaiting flag a row somebody has to
/// remember to write, and an unwritten one would then be indistinguishable from a
/// bug.
///
/// **A disposition is a decision, not a setting.** The first one recorded stands:
/// there is no reversal route, because a reversible confirm would mean an
/// Explanation entering and leaving an operator's queue underneath them.
///
/// It applies only to a `Student`-origin flag. A parent-origin flag *is* the parent's
/// own judgement already, so there is nothing for them to dispose of.
enum ExplanationFlagDisposition {
  Confirmed
  Dismissed

  @@map("explanation_flag_disposition")
}

/// One recorded concern about one Explanation.
///
/// A flag is a **record and nothing more**. It does not change the Explanation's
/// body, what the child is served, the grade state, the Attempt's score, Mastery or
/// any other row: suppression is Story 6.4's and it is the destructive act. There is
/// deliberately no `suppressedAt` and no `reason` column here — a column with no
/// writer is a promise the next reader will believe.
///
/// **There is no un-flagging.** No route deletes a row here, which is why the table
/// carries no soft-delete column either. A concern that was raised was raised.
///
/// `parentAccountId` and `studentProfileId` are denormalized onto the row for the
/// reason `Explanation`'s are: the Admin queue Story 6.3 builds reads flags by
/// account without joining the Explanation, and `parentAccountId` in particular
/// carries no foreign key so a flag can never be what blocks an account deletion.
/// The `explanationId` edge cascades, because a flag on a row that is gone is a
/// flag on nothing.
model ExplanationFlag {
  id               String                      @id @default(uuid())
  explanationId    String
  /// Whose account the flagged Explanation belongs to. Denormalized so a queue read
  /// is one statement over one index.
  parentAccountId  String
  /// The child the flagged Explanation was written for, copied off the Explanation
  /// and never taken from a request.
  studentProfileId String
  origin           ExplanationFlagOrigin
  /// What the parent decided about a concern their child raised, or null.
  ///
  /// **Nullable, and null means two different things that are the same absence**: a
  /// parent-origin flag has no disposition and needs none, and a student-origin flag
  /// nobody has read yet has not got one yet. Which of the two a null row is, is read
  /// off `origin` — it is not a third enum member, because "awaiting" is the lack of a
  /// decision rather than one of them.
  ///
  /// Written by `updateMany({ where: { id, disposition: null } })` and never by a
  /// read-then-write, so two simultaneous presses cannot both win and the first
  /// decision is final by the statement rather than by a check.
  disposition      ExplanationFlagDisposition?
  /// When that decision was recorded, or null for a row that carries none. Always
  /// written in the same statement as `disposition`: a set disposition with no instant
  /// beside it would be a decision nobody can date.
  dispositionAt    DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  explanation Explanation @relation(fields: [explanationId], references: [id], onDelete: Cascade)

  /// What makes a second press the **same** flag rather than a second row: the
  /// upsert that writes it targets this key, so idempotency is the index's promise
  /// and not a check somebody has to remember to make. It also keeps the first
  /// `createdAt`, because the instant a concern was first raised is the fact.
  @@unique([explanationId, origin])
  /// The one read index: this account's flags, newest first. Equality then range,
  /// exactly as `explanation`'s own count index is ordered.
  @@index([parentAccountId, createdAt])
  /// The Admin queue's index, in the queue read's own shape: "parent-origin, or
  /// student-origin confirmed, oldest qualifying first". Two equalities then the
  /// ordering column, which is the same equality-then-range shape the index above has.
  @@index([origin, disposition, createdAt])
  @@map("explanation_flag")
}
