{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "seed": "prisma generate && tsc -p tsconfig.seed.json && node .seed/prisma/seed.js",
    "db:generate": "prisma generate",
    "test:int": "vitest run test"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/throttler": "6.7.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.1",
    "@nestjs/schematics": "12.0.1",
    "@nestjs/testing": "12.0.1",
    "@swc/core": "1.13.5",
    "@types/express": "5.0.3",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "dotenv": "17.2.4",
    "eslint": "9.39.1",
    "pg": "8.16.3",
    "prisma": "7.10.0",
    "supertest": "7.1.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.46.1",
    "unplugin-swc": "1.5.7",
    "vitest": "3.2.4"
  },
  "type": "module"
}
